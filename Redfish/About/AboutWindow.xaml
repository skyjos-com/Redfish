<Window x:Class="Redfish.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Redfish.About"
        xmlns:loc="clr-namespace:Redfish.Localization"
        mc:Ignorable="d"
        Title="{Binding [About], Source={x:Static loc:Localization.Current}}" Language="{Binding XmlLanguage, Source={x:Static loc:Localization.Current}}" Height="270" Width="480" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Image HorizontalAlignment="Left" Height="100" Margin="20,20,0,0" VerticalAlignment="Top" Width="100" RenderTransformOrigin="0.364,-0.077" Source="../Resources/app_logo.png" />
        <Grid Margin="0,20,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" Height="115">
            <Label Content="{Binding [ProductName], Source={x:Static loc:Localization.Current}}" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="Bold" FontSize="24"/>
            <Label x:Name="version_label" Content="{Binding Version, Source={x:Static loc:Localization.Current}}" HorizontalAlignment="Center" Margin="0,40,0,0" VerticalAlignment="Top"/>
            <Label Content="{Binding [Copyright], Source={x:Static loc:Localization.Current}}" HorizontalAlignment="Center" Margin="0,66,0,0" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,95,0,0">           
                <Hyperlink NavigateUri="https://github.com/skyjos-com/Redfish" RequestNavigate="Hyperlink_Website">
                    <Run Text="{Binding [GitHubLink], Mode=OneWay, Source={x:Static loc:Localization.Current}}"/>
                </Hyperlink>
                -
                <Hyperlink NavigateUri="https://www.skyjos.com" RequestNavigate="Hyperlink_Website">
                    skyjos.com
                </Hyperlink>
            </TextBlock>
        </Grid>
        <TextBlock x:Name="description_textblock" Margin="20,0,20,20" TextWrapping="Wrap" Text="{Binding [Description], Source={x:Static loc:Localization.Current}}" VerticalAlignment="Bottom" FontSize="11" Height="55"/>

    </Grid>
</Window>
